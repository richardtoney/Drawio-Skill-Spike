        <mxCell id="ctx-email"
          value="&lt;b&gt;E-mail System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-style:italic;&quot;&gt;The internal Microsoft Exchange&lt;br&gt;e-mail system.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#8a8a8a;arcSize=7;fontSize=12;align=center;"
