        <mxCell id="ctx-customer"
          value="&lt;b&gt;Personal Banking Customer&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;font style=&quot;font-size:11px;font-style:italic;&quot;&gt;A customer of the bank, with&lt;br&gt;personal bank accounts.&lt;/font&gt;"
