          <mxGeometry x="100" y="230" width="160" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-ibs"
          value="&lt;b&gt;Internet Banking System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-style:italic;&quot;&gt;Allows customers to view&lt;br&gt;information about their bank&lt;br&gt;accounts, and make payments.&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0f5eaa;arcSize=7;fontSize=12;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="460" y="245" width="220" height="150" as="geometry"/>
