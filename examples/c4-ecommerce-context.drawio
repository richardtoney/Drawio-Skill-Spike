        <mxCell id="ec-leg-person" value="Person (internal)" style="rounded=1;whiteSpace=wrap;fillColor=#08427b;fontColor=#ffffff;strokeColor=#3c7fc0;arcSize=7;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="ec-leg-internal" value="Internal Software System" style="rounded=1;whiteSpace=wrap;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0f5eaa;arcSize=7;fontSize=11;" vertex="1" parent="1">
